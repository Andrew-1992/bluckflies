{
  "name": "bluckflies",
  "version": "0.1.0",
  "description": "BluckFlies — AI flight search, booking and travel assistant for South Sudan",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "connect:check": "tsx --env-file-if-exists=.env src/cli/checkConnections.ts",
    "eval": "tsx --env-file-if-exists=.env src/cli/runEvals.ts",
    "launch:check": "tsx src/cli/launchCheck.ts",
    "build:web": "tsx src/cli/buildWeb.ts",
    "staff:create-admin": "tsx --env-file-if-exists=.env src/cli/createAdmin.ts",
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pg": "node -e \"if(!process.env.TEST_DATABASE_URL){console.error('Set TEST_DATABASE_URL, e.g. postgresql://postgres@localhost:5432/postgres');process.exit(1)}\" && vitest run",
    "db:migrate:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "check": "npm run generate && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "^5.3.0",
    "pg": "8.23.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}

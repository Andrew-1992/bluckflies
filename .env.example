# Copy to .env and fill in. Never commit real secrets. Blank values mean "not set".
# Where to get each key: docs/CONNECT.md. Test them all with: npm run connect:check
# Production refuses sandbox flights, sandbox endpoints and test tokens: keep
# NODE_ENV=development for local demos, including `docker compose up`.
NODE_ENV=development
PORT=3000

# Legal pages (/terms, /privacy, /refunds) and footer. Until a lawyer has reviewed the
# texts in legal/*.html, keep LEGAL_PAGES_APPROVED=false: the pages show a "draft" banner.
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_ADDRESS=
LEGAL_COMPANY_REGISTRATION=
SUPPORT_EMAIL=
SUPPORT_PHONE=
LEGAL_PAGES_APPROVED=false
# Proxies in front of the app that add X-Forwarded-For: 1 for Caddy/nginx alone,
# 2 for a cloud load balancer in front of Caddy/nginx. Per-address rate limits depend on it.
TRUST_PROXY_HOPS=1
# Only when a front proxy (e.g. Vercel) adds this secret as the x-origin-secret header:
# the server then refuses requests that bypass the proxy. At least 32 characters.
ORIGIN_SECRET=

# Claude API key. Without it the API and web client run but chat returns 503.
ANTHROPIC_API_KEY=
# Testing without an Anthropic key: a scripted demo assistant (not AI) that searches
# flights and passes requests to the desk. Ignored when ANTHROPIC_API_KEY is set.
# Never in production.
AGENT_DEMO=false
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_MAX_TOOL_ITERATIONS=8
# Spending limits for the AI, in USD per Juba day (docs/CONNECT.md section 1a).
# At the daily budget the assistant pauses until midnight; travellers keep the
# step-by-step search and "call me". Ops get an alert at 80% and at 100%.
AGENT_DAILY_BUDGET_USD=20
AGENT_CONVERSATION_BUDGET_USD=0.5
# USD per million tokens. Leave blank for Sonnet 5.5 / Haiku 5.5 (built-in prices);
# set input and output together if Anthropic's prices change or for another model.
AGENT_PRICE_INPUT_PER_MTOK=
AGENT_PRICE_OUTPUT_PER_MTOK=
AGENT_PRICE_CACHE_WRITE_PER_MTOK=
AGENT_PRICE_CACHE_READ_PER_MTOK=

# ---------------------------------------------------------------- database
# PostgreSQL for the app's runtime role (row access only). Leave blank to keep
# data in memory (development only: everything is lost on restart).
# Local example: postgresql://bluckflies_app:<password>@localhost:5432/bluckflies
DATABASE_URL=
DATABASE_POOL_MAX=10
# Schema-owner role, used ONLY by `npm run db:deploy` / `db:migrate:dev`.
# Falls back to DATABASE_URL if blank (fine for a throwaway local database).
MIGRATION_DATABASE_URL=
# Only for `prisma migrate dev` when the owner role cannot create databases.
SHADOW_DATABASE_URL=

# Column encryption keyring for passport data, phone numbers, chat transcripts.
# Format: <id>:<base64 32-byte key>[,<id>:<key>…]; the FIRST key encrypts, all decrypt.
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# Losing every key makes encrypted data unreadable: store it in a secret manager and back it up.
DATA_ENCRYPTION_KEYS=

# Background jobs in this process (hold sweeper, payment reconciliation, cleanup).
JOBS_ENABLED=true
# Days to keep chat transcripts, idle sessions and webhook dedupe records.
DATA_RETENTION_DAYS=30
# Minutes before an unconfirmed payment or refund is checked directly with the provider.
RECONCILE_AFTER_MINUTES=15

# -------------------------------------------------- Docker Compose only
# Used by docker-compose.yml to create the database and its two roles.
# Use URL-safe values (e.g. hex): they are embedded in connection strings.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
BLUCKFLIES_OWNER_PASSWORD=
BLUCKFLIES_APP_PASSWORD=

# ------------------------------------------------------------------ flights
# sandbox = generated demo flights (development only); duffel = real airlines via Duffel.
FLIGHT_PROVIDER=sandbox
# duffel_test_… outside production (test bookings, no real tickets); duffel_live_… in production.
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_URL=https://api.duffel.com
# Secret of the Duffel webhook endpoint https://<domain>/api/webhooks/duffel (schedule changes).
DUFFEL_WEBHOOK_SECRET=
# Optional: only sell these airlines (IATA codes), e.g. ET,KQ,MS,TK,FZ,UR. Blank = all.
DUFFEL_AIRLINES=
# Serve routes within South Sudan from the sandbox (development only; must be false in production).
SANDBOX_DOMESTIC_FLIGHTS=true

# ---------------------------------------------------------------- payments
# HMAC secret for the mobile-money / sandbox webhook format (>= 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=

# DPO Pay (Network International): Visa/Mastercard bank cards, including cards
# issued by South Sudanese banks (KCB, Equity, Stanbic, ...). Both from DPO.
# Without DPO or Stripe, cards use the sandbox (development only).
DPO_COMPANY_TOKEN=
# Numeric service type DPO assigns to your account (e.g. "Flights").
DPO_SERVICE_TYPE=
DPO_API_URL=https://secure.3gdirectpay.com
# true = refund through DPO's API; false = staff refund in the DPO portal from a desk ticket.
DPO_AUTO_REFUNDS=false
# Only needed when both DPO and Stripe are configured: stripe | dpo
CARD_PROVIDER=

# Bank transfer / cash deposit at a branch, in USD. Staff confirm each payment on
# /desk.html (needs ADMIN_API_TOKEN). Blank in development = a demo account marked
# as demo; blank in production = bank transfer is off.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_SWIFT=

# Cash in USD at your offices or partner travel agents, confirmed on /desk.html with
# the receipt number. Entries separated by ";", fields by "|":
# CASH_OFFICES=BluckFlies Juba | Hai Malakal, Juba | Mon-Sat 08:00-17:00; Partner Travel | Konyo Konyo, Juba | Daily 09:00-18:00
# Blank in development = a demo office; blank in production = cash is off.
CASH_OFFICES=
# Staff two-step login (authenticator app). Blank = required in production, optional otherwise.
STAFF_REQUIRE_2FA=
# Bank and cash are only offered when at least this many minutes remain on the seat hold.
MANUAL_PAYMENT_MIN_MINUTES=45

# Stripe card payments (Checkout). Set both or neither; without them cards use the sandbox.
# Use test keys (sk_test_…) outside production. Prefer a restricted key (rk_…) with
# write access to Checkout Sessions and Refunds only.
STRIPE_SECRET_KEY=
# From the Dashboard webhook endpoint, or `stripe listen` output in development.
STRIPE_WEBHOOK_SECRET=
# Public origin used for Checkout success/cancel redirects (https in production).
PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------- SSP exchange rate
# Mobile money is charged in SSP at a rate locked per payment. Operators keep the
# rate current via POST /api/admin/fx-rates; this optional starting rate MUST be
# set together with the date it was published. There is deliberately no default.
SSP_PER_USD=
SSP_RATE_AS_OF=
SSP_RATE_SOURCE=configuration
# SSP charges are refused (card stays available) when the newest rate is older than this.
FX_MAX_AGE_HOURS=36
# Markup on the rate for SSP charges, in basis points (100 = 1%), to absorb movement.
FX_MARKUP_BPS=0
# Optional emergency sign-in for /desk.html and /api/admin (>= 32 chars), recorded under the
# name typed in. Staff normally use their own accounts (npm run staff:create-admin for the first).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=

# ---------------------------------------------------------- MTN MoMo
# MTN MoMo Open API. Blank = MTN MoMo uses the sandbox (development) or is off (production).
# Sandbox: MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com, MOMO_TARGET_ENVIRONMENT=sandbox, MOMO_CURRENCY=EUR.
MOMO_BASE_URL=https://proxy.momoapi.mtn.com
# The exact value MTN gives you (MTN's public list doesn't include South Sudan; ask MTN).
MOMO_TARGET_ENVIRONMENT=
MOMO_CURRENCY=SSP
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_COLLECTION_API_USER=
MOMO_COLLECTION_API_KEY=
# Optional Disbursement product for automatic refunds; blank = refunds become support tickets.
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_API_USER=
MOMO_DISBURSEMENT_API_KEY=

# ------------------------------------------------ accounts and messaging
# Secret for phone login codes, phone lookups and WhatsApp/SMS sessions (>= 32 chars).
# Required in production. Changing it signs everyone out of phone login.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# E-ticket, "seats held" and refund emails, and staff alerts, via Resend (https://resend.com).
# Required in production. Blank in development = emails are printed in the server log.
RESEND_API_KEY=
# e.g. BluckFlies <tickets@yourdomain.com> (the domain must be verified in Resend)
EMAIL_FROM=

# SMS via Twilio: login codes, e-ticket SMS, staff alerts and the SMS channel.
# Blank in development = SMS (including login codes) are printed in the server log.
# Blank in production = phone login and SMS are off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender: an E.164 number or a Messaging Service SID (MG…), which picks a valid sender per country.
TWILIO_FROM=
# Let travellers chat with BluckFlies by SMS. Point the Twilio number's incoming-message
# webhook to https://<domain>/api/webhooks/sms (HTTP POST).
SMS_CHANNEL_ENABLED=false

# WhatsApp Business Cloud API (Meta). All four together.
# Webhook URL: https://<domain>/api/webhooks/whatsapp, subscribed to "messages".
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any random string; enter the same value as the "Verify token" in the Meta app dashboard.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Booking messages for people who booked on WhatsApp (docs/CONNECT.md section 10a).
# Approved Meta message template names; blank = those people get SMS like everyone else.
WHATSAPP_TEMPLATE_HELD=
WHATSAPP_TEMPLATE_TICKETED=
WHATSAPP_TEMPLATE_REFUNDED=
# Template language codes as created in WhatsApp Manager.
WHATSAPP_TEMPLATE_LANG_EN=en
WHATSAPP_TEMPLATE_LANG_AR=ar
# Lets `npm run connect:check` confirm the templates are approved.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Operations alerts: paid booking not ticketed, payment amount mismatch, refund failed, Duffel
# balance too low, AI assistant down, messages failing, background jobs failing. Each alert is
# sent once (per booking, or at most hourly). Blank = the SUPPORT_ALERT_* lists below.
OPS_ALERT_EMAILS=
OPS_ALERT_PHONES=

# Staff alerted for every new support request (comma-separated). Work them at /desk.html.
SUPPORT_ALERT_EMAILS=
SUPPORT_ALERT_PHONES=

OFFER_TTL_MINUTES=30
HOLD_TTL_MINUTES=60

# Demo-only payment approval endpoint. Refused when NODE_ENV=production.
ENABLE_SANDBOX_ENDPOINTS=true

# ---------------------------------------------------------------- deployment only
# Read by deploy/docker-compose.caddy.yml and deploy/backup/*.sh, not by the app (docs/DEPLOY.md).
# SITE_DOMAIN=bluckflies.com
# BACKUP_AGE_RECIPIENT=age1...        # PUBLIC key; the private key stays off the server
# BACKUP_DIR=/home/deploy/backups/bluckflies
# BACKUP_KEEP_DAYS=14
# BACKUP_RCLONE_REMOTE=b2:bluckflies-backups
